# Environment Variables — Trade Service
# Copy this file to .env and fill in your values

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_strong_password_here

# JWT (Base64-encoded secret key, min 256 bits)
JWT_SECRET=your_base64_encoded_jwt_secret_here

# Internal Services
WALLET_SERVICE_URL=http://localhost:8082
LEDGER_SERVICE_URL=http://localhost:8083

# External Oracle
ORACLE_API_URL=https://api.exchangerate-api.com/v4/latest

# Eureka Discovery Server
EUREKA_URI=http://localhost:8761/eureka/
